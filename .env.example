# Copy this file to .env.local (local) or add these in your hosting dashboard (e.g. Vercel → Settings → Environment Variables).

# Your live domain, without a trailing slash. Used for canonical URLs, sitemap, Open Graph images and structured data.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Search Console → Add property → "HTML tag" method → copy only the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: Bing Webmaster Tools → "Meta tag" method → copy only the content="..." value.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
